  "semantic_controls": [
    {
      "id": "G01",
      "family": "Negated exclusion, not an extra positive request",
      "text_en": "A uses HiTrap Blue HP 1 mL. Give washing flow. Do not exclude washing flow; exclude operating elution only.",
      "text_fr": "A utilise HiTrap Blue HP 1 mL. Donne le débit de lavage. N’exclus pas le débit de lavage ; exclus uniquement l’élution opératoire.",
      "draft_expected_meaning": "One A washing/flow request; one A operating-elution exclusion. The negated exclusion creates no washing conflict and no extra elution request.",
      "limits": "Keep the full “Do not exclude” / “N’exclus pas” span with its scope. Do not count keyword negations as contradictory instructions.",
      "review_status": "pending",
      "text_sha256_utf8": {
        "en": "34886e7fae71a2af04a2fb5a2fa5329bc72f1c0722de526deec7b94695c5de88",
        "fr": "32c07d2ad6d53a1d49c31df68fbd477712fad78ffffaedfee9e4933ded2c9630"
      }
    },
    {
      "id": "G02",
      "family": "Not only / but also is an addition",
      "text_en": "For A on HiTrap Blue HP 1 mL, give not only the washing stopping criteria but also the binding-buffer formulations. Do not include operating elution.",
      "text_fr": "Pour A sur HiTrap Blue HP 1 mL, donne non seulement les critères de fin du lavage, mais aussi les formulations du tampon de fixation. N’inclus pas l’élution opératoire.",
      "draft_expected_meaning": "Two requested items: washing/stopping criteria and preparation/binding-buffer formulation. Operating elution is excluded; no exclusion of the first item.",
      "limits": "Preserve both information items and the addition relation; do not add a flow request or pair buffer alternatives.",
      "review_status": "pending",
      "text_sha256_utf8": {
        "en": "a14563d5e6e793b7bd077b2950ce6219d5e1f810733877de44533d169dd78799",
        "fr": "a1421c33d7703f1589836b082c1a96e2bb71e9dc3acf49af717032db82ff4ad0"
      }
    },
    {
      "id": "G03",
      "family": "False scenario fact versus information exclusion",
      "text_en": "In documentary scenario A, minor contaminants do not interfere with the intended application. Explain the general separation principle of SEC; do not choose a purification technique for this sample.",
      "text_fr": "Dans le scénario documentaire A, les contaminants mineurs n’interfèrent pas avec l’application prévue. Explique le principe général de séparation de la SEC ; ne choisis pas de technique de purification pour cet échantillon.",
      "draft_expected_meaning": "minor_contaminants_interfere is explicitly provided false with documentary_scenario role. SEC/principle is requested. No product or column is supplied or inferred, and no scenario fact is a verified observation.",
      "limits": "The factual negation is not an exclusion of interference information. Do not turn a documentary scenario into a recommendation or contamination diagnosis.",
      "review_status": "pending",
