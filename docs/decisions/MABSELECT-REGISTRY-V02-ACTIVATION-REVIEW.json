  "decisions": [
    {
      "id": "LA01",
      "topic": "Exact candidate",
      "proposal": "Review mabselect-local-v02 with the recorded staged authority digest, six release artifacts and 56 dependency bindings; preserve v01 as historical.",
      "status": "proposed",
      "original_human_message": null
    },
    {
      "id": "LA02",
      "topic": "Local scope",
      "proposal": "One configured private local authority root, one cooperating writer process, no model, paid API, HTTP exposure, UI dispatch or legacy-chat change.",
      "status": "proposed",
      "original_human_message": null
    },
    {
      "id": "LA03",
      "topic": "Allowed support",
      "proposal": "Only the five registered bundle purposes and thirteen exact source objects; Q09 provides clarification context, not a cleaning procedure. Preserve conditions, warnings, alternatives, quotations and reservations.",
      "status": "proposed",
      "original_human_message": null
    },
    {
      "id": "LA04",
      "topic": "Initial withdrawals",
      "proposal": "Explicitly approve version 1 with zero events if still appropriate. This is no additional withdrawal within this bounded release, not approval of all manual content or release of E118-I/E121-EQ.",
      "status": "proposed",
      "original_human_message": null
    },
    {
      "id": "LA05",
      "topic": "Failure and revocation policy",
      "proposal": "Unavailable on invalid global authority; hold scopes dependent on withdrawn support, preserve independent tasks and essential warnings. Source views use current withdrawal authority; drift discards results without fallback.",
      "status": "proposed",
      "original_human_message": null
    },
    {
      "id": "LA06",
      "topic": "Storage and recovery limits",
      "proposal": "Accept trusted local storage and pointer-only rollback detection. Whole-store rollback, multiple writers and malicious tampering need stronger external controls. Interrupted commit requires reviewed manual recovery; no automatic rollback.",
      "status": "proposed",
      "original_human_message": null
    },
    {
      "id": "LA07",
      "topic": "Post-approval execution",
      "proposal": "A later explicitly requested action may prepare approved decision records in the private runtime copy, preserve the exact human approval text, recompute consequential bindings and activate only the approved semantic scope. Keep staged versioned files and both freezes unchanged.",
      "status": "proposed",
      "original_human_message": null
    },
    {
      "id": "LA08",
      "topic": "Acceptance and stop conditions",
      "proposal": "After later activation, replay accepted cases and verify normal reads/citations, both freezes, head/pointer equality and unchanged protections. Lifecycle fault/withdrawal tests run in disposable copies; fail closed on any mismatch, never change the live register merely to test it.",
      "status": "proposed",
      "original_human_message": null
    }
  ],
