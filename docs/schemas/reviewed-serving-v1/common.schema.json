    "context": {
      "type": "object",
      "properties": {
        "bundles": {
          "type": "array",
          "items": {
            "$ref": "urn:bioprocess:reviewed-serving:v1:common#/$defs/bundle"
          },
          "minItems": 0
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "urn:bioprocess:reviewed-serving:v1:common#/$defs/passage"
          },
          "minItems": 0
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "urn:bioprocess:reviewed-serving:v1:common#/$defs/review"
          },
          "minItems": 0
        }
      },
      "required": [
        "bundles",
        "passages",
        "reviews"
      ],
      "additionalProperties": false
    },
    "item_outcome": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "requested_item": {
          "type": "string",
          "enum": [
            "cleaning_options",
            "restricted_sequence",
            "followup_buffer_pH",
            "pressure_limit",
            "solvent_hold_time"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "supported",
            "needs_clarification",
            "abstained",
            "quarantined",
            "unavailable",
            "excluded"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "documentary_support",
            "product_unknown",
            "context_unknown",
            "product_and_context_unknown",
            "product_conflict",
            "context_mixed",
            "outside_release_scope",
            "not_in_selected_excerpts",
            "review_withdrawn",
            "source_quarantined",
            "required_dependency_unavailable",
            "invalid_source_binding",
            "invalid_review_binding",
            "context_budget_incomplete",
            "release_not_activated",
            "invalid_authority",
            "authority_changed",
            "excluded_by_request"
          ]
        },
        "field_origins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "product",
                  "deposit_context",
                  "requested_item",
                  "exclusion"
                ]
              },
              "request_pointer": {
                "type": "string",
                "pattern": "^/tasks/[0-7]/(product|deposit_context|requested_items/[0-4]|excluded_items/[0-4])$"
              }
            },
            "required": [
              "field",
              "request_pointer"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "bundle_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mabselect.precipitated.general",
              "mabselect.precipitated.restricted",
              "mabselect.hydrophobic.detergent",
              "mabselect.hydrophobic.solvent",
              "mabselect.context.clarify"
            ]
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        },
        "withheld_bundle_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mabselect.precipitated.general",
              "mabselect.precipitated.restricted",
              "mabselect.hydrophobic.detergent",
              "mabselect.hydrophobic.solvent",
              "mabselect.context.clarify"
            ]
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        },
        "clarification_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "product",
              "deposit_context"
            ]
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "absence_scope": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle_refs": {
          "description": "Exact context object references for this task/item, including clarification-only context. bundle_keys alone is not an instance identifier.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/context/bundles/[0-9]+$"
          },
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "task_id",
        "requested_item",
        "state",
        "reason",
        "field_origins",
        "bundle_keys",
        "withheld_bundle_keys",
        "clarification_targets",
        "absence_scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "supported"
              }
            }
          },
          "then": {
            "properties": {
              "bundle_keys": {
                "minItems": 1
              },
              "reason": {
                "const": "documentary_support"
              },
              "clarification_targets": {
                "maxItems": 0
              },
              "absence_scope": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "bundle_keys": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "needs_clarification"
              }
            }
          },
          "then": {
            "properties": {
              "clarification_targets": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "clarification_targets": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "abstained"
              }
            }
          },
          "then": {
            "properties": {
              "absence_scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "excluded"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "excluded_by_request"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "needs_clarification"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "product_unknown",
                  "context_unknown",
                  "product_and_context_unknown",
                  "product_conflict",
                  "context_mixed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "abstained"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "outside_release_scope",
                  "not_in_selected_excerpts"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "quarantined"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "review_withdrawn",
                  "source_quarantined"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "required_dependency_unavailable",
                  "invalid_source_binding",
                  "invalid_review_binding",
                  "context_budget_incomplete",
                  "release_not_activated",
                  "invalid_authority",
                  "authority_changed"
                ]
              }
            }
          }
        }
      ]
    }
  }
