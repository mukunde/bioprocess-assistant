    "allow_unknown_scope": false,
    "min_raw_bm25_score": null,
    "relative_bm25_cutoff": null,
    "bm25_used_for": "Tie-breaking among already admissible mapped candidates only; a zero lexical score does not reject direct reviewed support.",
    "bm25_k1": 1.2,
    "bm25_b": 0.75,
    "bm25_index_context": true,
    "query_terms": "Positive canonical product/method/stage/information/facet lexemes only; never original question, exclusion text or gold answer.",
    "ordering": [
      "new_unblocked_information_units_covered_desc",
      "product_scope_specificity_desc",
