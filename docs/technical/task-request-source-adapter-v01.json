  "eligibility": "Use exact inherited transitive dependencies plus each candidate required_guard_source_ids and their inherited closure. Every member must be eligible. Raw preparation pending flags are historical and never confer approval.",
  "ranking_policy": {
    "min_direct_units_covered": 1,
    "require_reviewed_role_mapping": true,
