  "cases": [
    {
      "id": "UA01",
      "user_intent_en": "For MabSelect SuRe, what cleaning options are documented for precipitated or denatured substances, and is a numerical maximum pressure supplied?",
      "ui_controls": {
        "product": "sure",
        "context": "precipitated_substances",
        "cleaning": true,
        "pressure": true
      },
      "visible_product_label": "MabSelect SuRe",
      "visible_context_label": "Precipitated or denatured substances",
      "expected_request_payload": {
        "kind": "reviewed_serving_request/v1",
        "request_id": "registry-ui-request",
        "language": "en",
        "tasks": [
          {
            "task_id": "A",
            "product": "sure",
            "deposit_context": "precipitated_substances",
            "requested_items": [
              "cleaning_options",
              "pressure_limit"
            ],
            "excluded_items": []
          }
        ]
      },
      "test_focus": "General and product-restricted blocks remain separate; the pressure request must not suppress supported cleaning guidance."
    },
    {
