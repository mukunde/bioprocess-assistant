{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bioprocess:reviewed-serving:v1:validation-error",
  "title": "Reviewed serving v1 \u2014 validation error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "request_id",
    "errors"
  ],
  "properties": {
    "kind": {
      "const": "reviewed_serving_validation_error/v1"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "urn:bioprocess:reviewed-serving:v1:common#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "request_pointer"
        ],
        "properties": {
          "code": {
            "enum": [
              "unknown_authority_field",
              "unknown_field",
              "required_field_missing",
              "invalid_type",
              "unknown_selector",
              "duplicate_task_id",
              "request_too_large",
              "max_tasks_exceeded"
            ]
          },
          "request_pointer": {
            "type": "string",
            "pattern": "^(?:/.*)?$"
          }
        }
      }
    }
  }
}
