      "bm25_score_desc",
      "sorted_root_id_tuple_ascending"
    ],
    "score_quantization": "Round BM25 tie-break score to 12 decimal places using decimal ROUND_HALF_EVEN before comparison; raw score retained in audit.",
    "no_fallback": "No best-family or relative-score fallback outside registered roles.",
    "candidate_lexical_score": "Arithmetic mean of per-root BM25 scores; absent lexical root hit contributes zero. Round resulting tie-break score as specified.",
    "bm25_bilingual_aliases": false,
    "index_projection": "Original English source quotes plus inherited dependency quotes; no v05 vocabulary projection. The BM25 document universe is the inherited eligible searchable IDs, not only the eight interface roots.",
    "lexical_primitive": {
      "reference_file": "ingestion/local_passage_retrieval.py",
      "reference_sha256_lf": "835daa9fb4de02e2578a0867f26233d198b542d0cc4a44914e25e88ab1c908d4",
      "definition": "terms with bilingual=False, its fixed STOP list and the BM25 class equation/document statistics only. Sorted unique query tokens for reproducible floating-point summation. Do not call its old search top_k filter or assembler as the new planner.",
      "query_construction": "One common query per item visit: concatenate lexical_terms of all mapped candidates for currently unblocked uncovered units, resolved product canonical_label if relevant, resolved technique canonical_labels if relevant, stage code, requested ready information codes, and provided relevant facet codes. Tokenize with the pinned primitive and sort unique tokens. Never include other tasks, original wording, exclusions, observed numbers or expected answers.",
      "guard_indexing": "Extra role-level guards affect admission/context only, not the inherited dependency-based BM25 document statistics."
    }
  },
  "execution_policy": {
    "max_selected_distinct_roots": 6,
    "max_serialized_context_tokens": 2048,
    "tokenizer": {
