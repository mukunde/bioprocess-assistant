{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bioprocess:reviewed-serving:v1:release",
  "title": "Reviewed serving v1 — release",
  "type": "object",
  "properties": {
    "kind": {
      "const": "reviewed_serving_release/v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "staged",
        "activated"
      ]
    },
    "mode": {
      "const": "local_opt_in_no_model"
    },
    "contract_version": {
      "const": "1"
    },
    "prepared_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "renderer_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "design_decision_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "hash_convention": {
            "type": "string",
            "enum": [
              "sha256_lf",
              "raw_sha256"
            ]
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "hash_convention"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "activation_decision_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "hash_convention": {
              "type": "string",
              "enum": [
                "sha256_lf",
                "raw_sha256"
              ]
            }
          },
          "required": [
            "artifact_id",
            "sha256",
            "hash_convention"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "mapping_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_convention": {
          "type": "string",
          "enum": [
            "sha256_lf",
            "raw_sha256"
          ]
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "hash_convention"
      ],
      "additionalProperties": false
    },
    "withdrawals_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_convention": {
          "type": "string",
          "enum": [
            "sha256_lf",
            "raw_sha256"
          ]
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "hash_convention"
      ],
      "additionalProperties": false
    },
    "source_index_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_convention": {
          "type": "string",
          "enum": [
            "sha256_lf",
            "raw_sha256"
          ]
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "hash_convention"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "hash_convention": {
            "type": "string",
            "enum": [
              "sha256_lf",
              "raw_sha256"
            ]
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "hash_convention"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limits": {
      "type": "object",
      "properties": {
        "context_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 65536
        },
        "request_bytes": {
          "const": 32768
        },
        "max_tasks": {
          "const": 8
        }
      },
      "required": [
        "context_bytes",
        "request_bytes",
        "max_tasks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "release_id",
    "stage",
    "mode",
    "contract_version",
    "prepared_on",
    "adapter_version",
    "renderer_version",
    "design_decision_refs",
    "activation_decision_ref",
    "mapping_ref",
    "withdrawals_ref",
    "source_index_ref",
    "dependencies",
    "limits"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "activated"
          }
        }
      },
      "then": {
        "properties": {
          "activation_decision_ref": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "hash_convention": {
                "type": "string",
                "enum": [
                  "sha256_lf",
                  "raw_sha256"
                ]
              }
            },
            "required": [
              "artifact_id",
              "sha256",
              "hash_convention"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "activation_decision_ref": {
            "type": "null"
          }
        }
      }
    }
  ]
}
